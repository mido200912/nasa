# Server-side ASP.NET Core API origin used only by Next.js Route Handlers.
# Local API origin. Set the real private origin for deployment; never NEXT_PUBLIC_.
FIRE_SAFETY_API_BASE_URL=http://127.0.0.1:5082
# Default supports backend VulcanX:TimeoutSeconds=60 + cleanup (5s) + transport (10s).
FIRE_SAFETY_API_TIMEOUT_SECONDS=75
# Must equal backend VulcanX:TimeoutSeconds. Proxy must allow at least this +15s.
FIRE_SAFETY_AI_TIMEOUT_SECONDS=60
# Optional: set the REAL host execution ceiling; startup requests fail closed if
# proxy timeout + 5s response overhead cannot fit. Short hosts need async jobs.
# FIRE_SAFETY_MAX_EXECUTION_SECONDS=90
# Enable ONLY after an approved edge overwrites X-Flame-Client-IP and Next ingress
# is restricted to that edge. Backend TrustedProxyAddresses must name Next's peers.
FIRE_SAFETY_TRUST_EDGE_CLIENT_IP=false
