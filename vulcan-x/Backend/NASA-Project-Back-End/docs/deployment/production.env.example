# Inventory/template, NOT an env file for automatic loading. Assign each variable
# ONLY to its owning service via the selected platform's secret/config manager.
# Never paste real keys or connection strings into this tracked template.

# NEXT.JS ONLY
NODE_ENV=production
FIRE_SAFETY_API_BASE_URL=http://APPROVED_PRIVATE_API_ORIGIN
FIRE_SAFETY_AI_TIMEOUT_SECONDS=60
FIRE_SAFETY_API_TIMEOUT_SECONDS=75
# REQUIRED deployment decision: actual hard execution ceiling, not an invented value.
FIRE_SAFETY_MAX_EXECUTION_SECONDS=
FIRE_SAFETY_TRUST_EDGE_CLIENT_IP=false

# ASP.NET ONLY
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__FireSafetyDb=
VulcanX__BaseUrl=http://APPROVED_PRIVATE_BUN_ORIGIN
VulcanX__TimeoutSeconds=60
HabitatSubmission__Enabled=false
AnonymousRateLimit__RequestsPerMinute=120
AnonymousRateLimit__KnowledgePerMinute=6
AnonymousRateLimit__KnowledgePerHour=100
AnonymousRateLimit__MaximumClients=4096
# Set explicit Next peer IPs only after network approval; no implicit trust.
# TrustedProxyAddresses__0=
# AllowedHosts=APPROVED_API_HOSTS
# Provisioning job only, never the ordinary app:
# DATABASE_MIGRATION_CONFIRM=APPROVED_DATABASE_NAME

# VULCAN-X ONLY
PORT=4000
# In a private container network only; do not publish port 4000.
VULCANX_BIND_HOST=0.0.0.0
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY_1=
OPENROUTER_MAX_OUTPUT_TOKENS=512
KNOWLEDGE_TIMEOUT_MS=7000
PROVIDER_TIMEOUT_MS=55000
PROVIDER_ATTEMPT_TIMEOUT_MS=40000
KEY_COOLDOWN_MS=60000
