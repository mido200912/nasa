# ==============================================================================
# VULCAN-X: AI ENGINE & SPACE COMBUSTION BACKEND (OpenRouter 5-Key Pool)
# 2026 NASA Space Apps Challenge: "Flame in Freefall"
# ==============================================================================

PORT=4000
NODE_ENV=development

# OpenRouter Base URL & Default Model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
KEY_COOLDOWN_MS=60000

# ==============================================================================
# 5 OPENROUTER API KEYS ROTATION POOL & FAILOVER CONFIGURATION
# Insert your 5 OpenRouter API keys below.
# Whenever a key hits a rate limit (429) or quota limit (402), the system
# automatically rotates to the next available key without interrupting requests.
# ==============================================================================

OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
